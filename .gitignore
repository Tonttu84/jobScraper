# hand-written drop-audit labels: the owner keeps them in a private repo
data/labels/
# Per-profile working data (databases, runs/, serve/, exports/, cache/).
data/profiles/
# Other candidates' profiles carry their personal data; only the layout note is tracked.
config/profiles/*
!config/profiles/README.md

# persistent headless-browser profile (Cloudflare clearance cookie)
data/browser/

# The owner's own profile holds a CV; it lives in the private repo (scripts/sync_private.sh).
config/profile.yaml
# The owner's answers to docs/DOSSIER-QUESTIONNAIRE.md; condensed into the profile's dossier.
config/dossier-answers.md
# Notes on the owner's other repositories, read for the dossier (private, synced like the answers).
config/dossier-notes/
# The CV parts library (every sentence a tailored CV may contain) holds personal data.
config/cv-parts.yaml
# Local-only learning plan (not synced anywhere).
config/learning-plan.md

# transfer archives built for the owner's laptop (see README-restore.txt inside)
/jobscraper-owner-*.zip

# The owner's CV exports (Canva PDF/PNG) and generated tailored CVs: personal data, never tracked.
data/cv/
